# SQLite database location (used by Prisma)
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Optional AI integration. The app works WITHOUT these using the deterministic
# prompt generator. If an API key is present, AI-assisted event structuring and
# prompt generation are enabled automatically.
# ---------------------------------------------------------------------------

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=""
# Override the base URL to use a compatible provider (e.g. local LLM, Together, Groq).
OPENAI_BASE_URL="https://api.openai.com/v1"
# Model used for structuring + prompt generation.
OPENAI_MODEL="gpt-4o-mini"

# ---------------------------------------------------------------------------
# Optional image generation (stubbed for MVP). See lib/imageGen.ts TODO.
# ---------------------------------------------------------------------------
IMAGE_GEN_ENABLED="false"
