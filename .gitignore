# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# database (SQLite)
/prisma/*.db
/prisma/*.db-journal
*.db
*.db-journal

# env
.env
.env*.local

# uploaded reference art (kept out of git; the directory is tracked via .gitkeep)
/public/uploads/*
!/public/uploads/.gitkeep

# generated render assets (content-addressed; ephemeral)
/public/generated/*
!/public/generated/.gitkeep

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# typescript
*.tsbuildinfo
